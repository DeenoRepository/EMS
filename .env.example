# EMS deployment environment template
# Copy this file to .env and replace every CHANGE_ME value before starting Compose.
# Never commit the real .env file. Rotate credentials that were ever deployed with defaults.

# Required database credentials
POSTGRES_DB=ems_db
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=

# Required JWT signing secret (use at least 32 random bytes)
JWT_SECRET=

# Required MinIO/S3 credentials
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Non-secret storage settings
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ems-documents

# LDAP mock authentication must never be enabled in production.
LDAP_MOCK_SUCCESS=false

# Database connection pooling (CODE-04)
# Append these parameters to DATABASE_URL:
#   ?connection_limit=10&pool_timeout=20
# - connection_limit: max connections per Prisma instance (default: num_physical_cpus * 2 + 1)
# - pool_timeout: seconds to wait for a free connection (default: 10)

# Redis (SEC-03) - required in production
REDIS_URL=redis://:password@redis:6379
REDIS_PASSWORD=

# LDAP (SEC-11) - optional, for AD integration
# LDAP_URL=ldap://ldap.company.local:389
# LDAP_BASE_DN=dc=company,dc=local
# LDAP_BIND_DN=cn=ems-service,ou=service,dc=company,dc=local
# LDAP_BIND_PASSWORD=
# LDAP_DOMAIN=company.local

# CORS (SEC-16) - comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://ems.company.local

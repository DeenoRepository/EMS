generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  VIEWER
  EDITOR
  APPROVER
  ADMIN
  STOREKEEPER
}

enum EquipmentStatus {
  DRAFT
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum LifecycleStage {
  PLANNED
  COMMISSIONED
  IN_OPERATION
  MAINTENANCE
  RETIRED
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocumentType {
  PASSPORT
  OPERATION_MANUAL
  CERTIFICATE
  ACT
  DRAWING
  OTHER
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum ApprovalTargetType {
  EQUIPMENT_VERSION
  DOCUMENT_VERSION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  EXPORT
}

enum EventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  DOCUMENT_ATTACHED
  APPROVAL_SUBMITTED
  APPROVAL_RESOLVED
}

enum ReferenceEntityType {
  EQUIPMENT
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  displayName   String
  passwordHash  String?
  adExternalId  String?           @unique
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userRoles     UserRole[]
  auditLogs     AuditLog[]        @relation("AuditActor")
  submittedReqs ApprovalRequest[] @relation("SubmittedBy")
  assignedReqs  ApprovalRequest[] @relation("AssignedApprover")
  decidedReqs   ApprovalRequest[] @relation("DecidedBy")
  equipmentEvents EquipmentEvent[] @relation("EventActor")
  equipmentVersions EquipmentVersion[] @relation("VersionAuthor")
  documentVersions DocumentVersion[] @relation("DocVersionAuthor")
  responsibleEquipment Equipment[] @relation("ResponsibleEquipment")
}

model Role {
  id        String   @id @default(cuid())
  key       RoleKey  @unique
  name      String
  createdAt DateTime @default(now())
  userRoles UserRole[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Equipment {
  id             String            @id @default(cuid())
  equipmentCode  String            @unique
  name           String
  type           String?
  category       String?
  model          String
  serialNumber   String?
  inventoryNumber String?          @unique
  department     String?
  location       String?
  responsibleUserId String?
  manufacturer   String?
  supplier       String?
  productionDate DateTime?
  deliveryDate   DateTime?
  commissioningDate DateTime?
  warrantyExpiration DateTime?
  serviceDueDate DateTime?
  criticality    String?
  countryOfOrigin String?
  isImported     Boolean?          @default(false)
  isUnique       Boolean?          @default(false)
  notes          String?
  customAttributes Json?
  status         EquipmentStatus   @default(DRAFT)
  lifecycleStage LifecycleStage    @default(COMMISSIONED)
  currentVersion Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  versions       EquipmentVersion[]
  documents      Document[]
  events         EquipmentEvent[]
  responsibleUser User?            @relation("ResponsibleEquipment", fields: [responsibleUserId], references: [id])

  @@index([name])
  @@index([status])
  @@index([type, category])
  @@index([department, location])
  @@index([serviceDueDate, warrantyExpiration])
}

model EquipmentTypeAttribute {
  id          String   @id @default(cuid())
  typeValue   String
  key         String
  label       String
  dataType    String   @default("TEXT")
  required    Boolean  @default(false)
  options     Json?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([typeValue, key])
  @@index([typeValue, isActive, sortOrder])
}

model EquipmentVersion {
  id            String   @id @default(cuid())
  equipmentId   String
  versionNumber Int
  changeSummary String?
  snapshot      Json
  createdAt     DateTime @default(now())
  createdById   String

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdBy User      @relation("VersionAuthor", fields: [createdById], references: [id])

  @@unique([equipmentId, versionNumber])
  @@index([createdAt])
}

model Document {
  id          String          @id @default(cuid())
  equipmentId String
  title       String
  docType     DocumentType
  status      DocumentStatus  @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    DocumentVersion[]
  equipment   Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  versionNumber Int
  fileName      String
  storagePath   String
  checksum      String
  notes         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  createdById   String

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocVersionAuthor", fields: [createdById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([createdAt])
}

model ApprovalRequest {
  id                String             @id @default(cuid())
  targetType        ApprovalTargetType
  targetId          String
  status            ApprovalStatus     @default(PENDING)
  requestedById     String
  assignedApproverId String?
  decidedById       String?
  submittedAt       DateTime           @default(now())
  decidedAt         DateTime?
  comments          String?

  requestedBy User  @relation("SubmittedBy", fields: [requestedById], references: [id])
  assignedApprover User? @relation("AssignedApprover", fields: [assignedApproverId], references: [id])
  decidedBy   User? @relation("DecidedBy", fields: [decidedById], references: [id])

  @@index([status, submittedAt])
  @@index([targetType, targetId])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  actorEmail  String?
  action      AuditAction
  entityType  String
  entityId    String
  beforeState Json?
  afterState  Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model EquipmentEvent {
  id          String    @id @default(cuid())
  equipmentId String
  eventType   EventType
  title       String
  description String?
  payload     Json?
  createdAt   DateTime  @default(now())
  actorId     String?

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  actor     User?     @relation("EventActor", fields: [actorId], references: [id])

  @@index([equipmentId, createdAt])
}

model ReferenceField {
  id          String              @id @default(cuid())
  entityType  ReferenceEntityType @default(EQUIPMENT)
  key         String
  label       String
  description String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  values      ReferenceValue[]

  @@unique([entityType, key])
  @@index([entityType, isActive, sortOrder])
}

model ReferenceValue {
  id         String         @id @default(cuid())
  fieldId    String
  value      String
  label      String
  isActive   Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  field      ReferenceField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value])
  @@index([fieldId, isActive, sortOrder])
}

enum WmsItemType {
  ZIP
  CONSUMABLE
  TOOL
  EQUIPMENT_PART
  PPE
}

enum WmsItemStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCKED
}

enum WmsMovementType {
  INCOMING
  OUTGOING
  TRANSFER
  RESERVE
  ADJUSTMENT
  PERSONAL_CARD
}

enum WmsTransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WmsRequisitionStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
}

enum WmsWriteOffReason {
  EQUIPMENT_REPAIR
  SCRAP
  NON_LIQUID
  EXPIRED
  DAMAGE
  OTHER
}

model Warehouse {
  id                  String   @id @default(cuid())
  name                String   @unique
  code                String?
  location            String?
  responsibleUser     String
  responsibleUsername String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  zones               WmsZone[]
  storageCells        StorageCell[]
}

model WmsZone {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cells     StorageCell[]

  @@unique([warehouseId, code])
}

model StorageCell {
  id          String    @id @default(cuid())
  warehouseId String
  zoneId      String?
  code        String
  description String?
  capacity    Int?      @default(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone      WmsZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, code])
}

model WmsItem {
  id                  String        @id @default(cuid())
  sku                 String
  name                String
  category            String
  type                WmsItemType   @default(ZIP)
  unit                String        @default("pcs")
  warehouse           String
  cell                String?
  zone                String?
  batchNumber         String?
  serialNumber        String?
  quantity            Int           @default(0)
  minQuantity         Int           @default(0)
  maxQuantity         Int           @default(100)
  reservedQuantity    Int           @default(0)
  unitPrice           Float         @default(0)
  currency            String        @default("RUB")
  status              WmsItemStatus @default(IN_STOCK)
  isEps               Boolean       @default(false)
  supplier            String?
  compatibleEquipment Json?
  equipmentId         String?
  lastIncomingDate    DateTime?
  lastOutgoingDate    DateTime?
  responsibleUser     String?
  description         String?
  techSpecs           Json?
  barcode             String?       @unique
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  movements           WmsMovement[]
  transferRequests    WmsTransferRequest[]
  personalCards       WmsPersonalCard[]
  requisitions        WmsRequisitionItem[]
  reservations        WmsReservation[]
  writeOffs           WmsWriteOff[]

  @@unique([sku, warehouse])
  @@index([name])
  @@index([category])
  @@index([warehouse])
  @@index([status])
  @@index([batchNumber])
  @@index([serialNumber])
}

model WmsMovement {
  id               String          @id @default(cuid())
  itemId           String
  itemSku          String
  itemName         String
  type             WmsMovementType
  quantity         Int
  fromLocation     String?
  toLocation       String?
  performedBy      String
  recipientUser    String?
  reason           String?
  relatedOrderOrEq String?
  createdAt        DateTime        @default(now())

  item WmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model WmsTransferRequest {
  id                  String            @id @default(cuid())
  itemId              String
  itemSku             String
  itemName            String
  quantity            Int
  fromWarehouse       String
  toWarehouse         String
  requestedBy         String
  requestedByUsername String?
  targetMolUser       String
  targetMolUsername   String?
  reason              String?
  status              WmsTransferStatus @default(PENDING)
  comment             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  item WmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([status])
  @@index([fromWarehouse, toWarehouse])
}

model WmsRequisition {
  id                  String               @id @default(cuid())
  requisitionNumber   String               @unique
  fromWarehouse       String
  toWarehouse         String
  requestedBy         String
  status              WmsRequisitionStatus @default(REQUESTED)
  note                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               WmsRequisitionItem[]

  @@index([status])
  @@index([fromWarehouse, toWarehouse])
}

model WmsRequisitionItem {
  id            String   @id @default(cuid())
  requisitionId String
  itemId        String
  itemSku       String
  itemName      String
  quantity      Int

  requisition WmsRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        WmsItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WmsReservation {
  id                  String    @id @default(cuid())
  itemId              String
  equipmentId         String?
  equipmentName       String?
  maintenancePlanDate DateTime?
  reservedQuantity    Int
  reservedBy          String
  reason              String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  item WmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([equipmentId])
}

model WmsWriteOff {
  id             String            @id @default(cuid())
  itemId         String
  itemSku        String
  itemName       String
  quantity       Int
  reason         WmsWriteOffReason @default(EQUIPMENT_REPAIR)
  equipmentId    String?
  equipmentName  String?
  performedBy    String
  comments       String?
  createdAt      DateTime          @default(now())

  item WmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([reason])
}

model WmsPersonalCard {
  id               String    @id @default(cuid())
  itemId           String
  itemSku          String
  itemName         String
  employeeName     String
  employeePosition String?
  employeeNumber   String?   // Табельный номер
  department       String?
  issuedQuantity   Int
  issuedAt         DateTime  @default(now())
  returnedAt       DateTime?
  returnCondition  String?   // GOOD, REPAIR, SCRAPPED
  notes            String?
  createdById      String?

  item WmsItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([employeeName])
  @@index([employeeNumber])
}

model WmsEmployee {
  id             String   @id @default(cuid())
  name           String
  employeeNumber String   @unique // Табельный номер
  position       String?
  department     String?
  warehouse      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([employeeNumber])
  @@index([department])
}

model EnterpriseFacility {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemModule {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

